NODE_ENV=development
WEB_PORT=3000
REALTIME_PORT=1234
NEXT_PUBLIC_REALTIME_URL=ws://localhost:1234

# PostgreSQL
POSTGRES_USER=collabdocs
POSTGRES_PASSWORD=collabdocs
POSTGRES_DB=collabdocs
DATABASE_URL=postgresql://collabdocs:collabdocs@localhost:5432/collabdocs?schema=public
APP_URL=http://localhost:3000

# Production ingress and smoke verification
COLLABDOCS_DOMAIN=docs.example.com
COLLABDOCS_BASE_URL=https://docs.example.com
COLLABDOCS_IMAGE_TAG=main
TLS_CERTIFICATE=/etc/letsencrypt/live/docs.example.com/fullchain.pem
TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/docs.example.com/privkey.pem

# S3-compatible local storage
MINIO_ROOT_USER=collabdocs
MINIO_ROOT_PASSWORD=collabdocs-local-secret
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=collabdocs
S3_ACCESS_KEY=collabdocs
S3_SECRET_KEY=collabdocs-local-secret
S3_FORCE_PATH_STYLE=true
